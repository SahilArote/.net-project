@model ReportDashboardViewModel
@{
    ViewData["Title"] = "Reports & Analytics";

    var palette = new[] {
        "#0F172A", // Slate 900
        "#2563EB", // Blue 600
        "#10B981", // Emerald 500
        "#F59E0B", // Amber 500
        "#8B5CF6", // Violet 500
        "#EC4899", // Pink 500
        "#06B6D4", // Cyan 500
        "#F97316", // Orange 500
        "#64748B"  // Slate 500
    };
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">Reports & Analytics</h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Aggregate statistics, resolution performance, and problem category trends</p>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors shadow-2xs">
            <span>&larr;</span> Admin Dashboard
        </a>
    </div>
</div>

<!-- Resolution Summary Hero Card -->
<div class="bg-gray-900 text-white rounded-xl p-6 sm:p-8 shadow-sm mb-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Overall Resolution Rate</div>
            <div class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-2">@Model.ResolutionRatePercentage%</div>
            <p class="text-xs sm:text-sm text-gray-300">
                @(Model.ResolvedCount + Model.ClosedCount) of @Model.TotalComplaints total complaints have reached resolution or closure.
            </p>
        </div>

        <div class="flex items-center gap-4">
            <div class="bg-white/10 rounded-xl px-5 py-3.5 border border-white/10 text-center">
                <div class="text-2xl font-bold text-white">@Model.ResolvedCount</div>
                <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 mt-0.5">Resolved</div>
            </div>
            <div class="bg-white/10 rounded-xl px-5 py-3.5 border border-white/10 text-center">
                <div class="text-2xl font-bold text-white">@Model.ClosedCount</div>
                <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-400 mt-0.5">Closed</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Counts Grid -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Filed</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-gray-900">@Model.TotalComplaints</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Submitted</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-700">@Model.SubmittedCount</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-amber-700 mb-1">Under Review</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-800">@Model.UnderReviewCount</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 mb-1">Resolved</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-emerald-800">@Model.ResolvedCount</div>
    </div>
    <div class="col-span-2 sm:col-span-1 bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-indigo-700 mb-1">Closed</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-indigo-800">@Model.ClosedCount</div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Category Distribution: Interactive Pie / Donut Chart -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-gray-900">Complaints by Category</h2>
            <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
                @Model.ComplaintsByCategory.Count @(Model.ComplaintsByCategory.Count == 1 ? "category" : "categories")
            </span>
        </div>

        @if (!Model.ComplaintsByCategory.Any())
        {
            <div class="flex-1 flex flex-col items-center justify-center py-12 text-center">
                <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-3">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                    </svg>
                </div>
                <p class="text-xs text-gray-500">No complaint category data recorded yet.</p>
            </div>
        }
        else
        {
            <div class="flex-1 flex flex-col sm:flex-row items-center gap-6 pt-2">
                <!-- SVG Donut Chart with Center Label -->
                <div class="relative w-48 h-48 shrink-0 flex items-center justify-center">
                    <svg viewBox="0 0 42 42" class="w-48 h-48 -rotate-90 origin-center">
                        <!-- Background track -->
                        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="#F1F5F9" stroke-width="5" />

                        @{
                            double accumulatedPct = 0;
                        }
                        @for (int i = 0; i < Model.ComplaintsByCategory.Count; i++)
                        {
                            var cat = Model.ComplaintsByCategory[i];
                            var color = palette[i % palette.Length];
                            var pct = cat.Percentage;
                            var offset = 100 - accumulatedPct;
                            accumulatedPct += pct;

                            <circle cx="21" cy="21" r="15.9155" fill="none"
                                    stroke="@color"
                                    stroke-width="5"
                                    stroke-dasharray="@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) @((100 - pct).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))"
                                    stroke-dashoffset="@offset.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                    class="pie-slice transition-all duration-300 hover:stroke-[6.5] cursor-pointer"
                                    data-category="@cat.CategoryName"
                                    data-count="@cat.Count"
                                    data-pct="@cat.Percentage%"
                                    data-color="@color" />
                        }
                    </svg>

                    <!-- Center Readout -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center px-4">
                        <span id="donut-center-value" class="text-3xl font-extrabold text-gray-900 transition-all duration-200">
                            @Model.TotalComplaints
                        </span>
                        <span id="donut-center-label" class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mt-0.5 truncate max-w-[120px] transition-all duration-200">
                            Complaints
                        </span>
                    </div>
                </div>

                <!-- Category Legend List -->
                <div class="flex-1 w-full space-y-2 max-h-56 overflow-y-auto pr-1">
                    @for (int i = 0; i < Model.ComplaintsByCategory.Count; i++)
                    {
                        var cat = Model.ComplaintsByCategory[i];
                        var color = palette[i % palette.Length];

                        <div class="category-legend-item flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all cursor-pointer"
                             data-category="@cat.CategoryName"
                             data-count="@cat.Count"
                             data-pct="@cat.Percentage%"
                             data-color="@color">
                            <div class="flex items-center gap-2.5 min-w-0 pr-2">
                                <span class="w-3 h-3 rounded-full shrink-0 shadow-2xs" style="background-color: @color;"></span>
                                <span class="text-xs font-semibold text-gray-800 truncate">@cat.CategoryName</span>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="text-xs font-medium text-gray-500">@cat.Count @(cat.Count == 1 ? "complaint" : "complaints")</span>
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-semibold bg-gray-100 text-gray-800">
                                    @cat.Percentage%
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Monthly Submission Volume -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-base font-bold text-gray-900 mb-4">Monthly Submission Volume (Last 6 Months)</h2>

        @if (!Model.MonthlyTrend.Any())
        {
            <p class="text-xs text-gray-500 text-center py-8">No monthly submission activity recorded.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-left text-xs">
                    <thead class="bg-gray-50/75">
                        <tr>
                            <th scope="col" class="py-2.5 px-3 font-semibold text-gray-600 uppercase tracking-wider">Month</th>
                            <th scope="col" class="py-2.5 px-3 font-semibold text-gray-600 uppercase tracking-wider text-right">Complaints Received</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var m in Model.MonthlyTrend)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="py-2.5 px-3 font-semibold text-gray-900">
                                    @m.MonthYear
                                </td>
                                <td class="py-2.5 px-3 text-right font-bold text-gray-900">
                                    @m.Count
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const centerVal = document.getElementById('donut-center-value');
            const centerLabel = document.getElementById('donut-center-label');
            const defaultVal = "@Model.TotalComplaints";
            const defaultLabel = "Complaints";

            function highlight(name, count, pct, color) {
                if (centerVal && centerLabel) {
                    centerVal.textContent = count;
                    centerLabel.textContent = `${name} (${pct})`;
                    if (color) centerVal.style.color = color;
                }
            }

            function reset() {
                if (centerVal && centerLabel) {
                    centerVal.textContent = defaultVal;
                    centerLabel.textContent = defaultLabel;
                    centerVal.style.color = '';
                }
            }

            // Slices
            document.querySelectorAll('.pie-slice').forEach(slice => {
                slice.addEventListener('mouseenter', () => {
                    const name = slice.getAttribute('data-category');
                    const count = slice.getAttribute('data-count');
                    const pct = slice.getAttribute('data-pct');
                    const color = slice.getAttribute('data-color');
                    highlight(name, count, pct, color);
                });
                slice.addEventListener('mouseleave', reset);
            });

            // Legend items
            document.querySelectorAll('.category-legend-item').forEach(item => {
                item.addEventListener('mouseenter', () => {
                    const name = item.getAttribute('data-category');
                    const count = item.getAttribute('data-count');
                    const pct = item.getAttribute('data-pct');
                    const color = item.getAttribute('data-color');
                    highlight(name, count, pct, color);
                });
                item.addEventListener('mouseleave', reset);
            });
        });
    </script>
}
