@model ReportDashboardViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-bottom: 0.25rem;">Complaint Reports & Analytics</h1>
        <p class="subtitle" style="margin-bottom: 0;">Aggregate statistics and problem area breakdowns</p>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
            &larr; Admin Dashboard
        </a>
    </div>
</div>

<!-- Resolution Summary Card -->
<div class="card" style="background: linear-gradient(135deg, #111827 0%, #1F2937 100%); color: #FFFFFF; border: none; margin-bottom: 2rem; padding: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: #9CA3AF; margin-bottom: 0.5rem;">Complaint Resolution Rate</div>
            <div style="font-size: 3rem; font-weight: 700; line-height: 1;">@Model.ResolutionRatePercentage%</div>
            <div style="font-size: 0.9rem; color: #D1D5DB; margin-top: 0.5rem;">
                @(Model.ResolvedCount + Model.ClosedCount) of @Model.TotalComplaints complaints have been resolved or closed.
            </div>
        </div>
        <div style="display: flex; gap: 1.5rem; text-align: center;">
            <div style="background: rgba(255, 255, 255, 0.1); padding: 1rem 1.5rem; border-radius: var(--radius-sm);">
                <div style="font-size: 1.5rem; font-weight: 700;">@Model.ResolvedCount</div>
                <div style="font-size: 0.775rem; color: #9CA3AF; text-transform: uppercase;">Resolved</div>
            </div>
            <div style="background: rgba(255, 255, 255, 0.1); padding: 1rem 1.5rem; border-radius: var(--radius-sm);">
                <div style="font-size: 1.5rem; font-weight: 700;">@Model.ClosedCount</div>
                <div style="font-size: 0.775rem; color: #9CA3AF; text-transform: uppercase;">Closed</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Filed</div>
        <div class="stat-value">@Model.TotalComplaints</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Submitted</div>
        <div class="stat-value submitted">@Model.SubmittedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Under Review</div>
        <div class="stat-value underreview">@Model.UnderReviewCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Resolved</div>
        <div class="stat-value resolved">@Model.ResolvedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Closed</div>
        <div class="stat-value closed">@Model.ClosedCount</div>
    </div>
</div>

<!-- Category Distribution -->
<div class="card">
    <div class="card-header-clean">
        <h2>Complaints by Category</h2>
    </div>

    @if (!Model.ComplaintsByCategory.Any())
    {
        <p style="color: var(--text-secondary); text-align: center; padding: 2rem;">No complaint data available to display.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            @foreach (var cat in Model.ComplaintsByCategory)
            {
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem;">
                        <span style="font-weight: 600;">@cat.CategoryName</span>
                        <span style="color: var(--text-secondary);">@cat.Count complaints (@cat.Percentage%)</span>
                    </div>
                    <div style="background-color: var(--bg-color); height: 8px; border-radius: 9999px; overflow: hidden; border: 1px solid var(--border-subtle);">
                        <div style="background-color: var(--primary); height: 100%; width: @(cat.Percentage)%; border-radius: 9999px;"></div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Monthly Trend -->
<div class="card">
    <div class="card-header-clean">
        <h2>Monthly Submission Volume (Last 6 Months)</h2>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th style="text-align: right;">Complaints Received</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.MonthlyTrend)
                {
                    <tr>
                        <td><strong>@m.MonthYear</strong></td>
                        <td style="text-align: right; font-weight: 600;">@m.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
