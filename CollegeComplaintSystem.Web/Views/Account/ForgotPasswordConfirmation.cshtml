@{
    ViewData["Title"] = "Password Reset Requested";
}

<div style="max-width: 480px; margin: 3rem auto; text-align: center;">
    <div class="card" style="padding: 2.5rem 1.5rem;">
        <div style="font-size: 2.75rem; margin-bottom: 1rem;">📬</div>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Password Reset Sent</h2>
        <p style="color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
            If an active account exists for that email, we have dispatched a password reset link. Please check your inbox.
        </p>
        <a asp-action="Login" class="btn btn-secondary">Return to Sign In</a>
    </div>
</div>
