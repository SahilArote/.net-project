@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div style="max-width: 440px; margin: 2rem auto;">
    <div class="card">
        <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem; text-align: center;">Set New Password</h2>
        <p class="subtitle" style="text-align: center; margin-bottom: 1.5rem;">Choose a strong new password for your account</p>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autofocus />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 0.5rem;">
                Reset Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
