@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="max-w-md mx-auto py-8 sm:py-12">
    <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">Reset Password</h1>
            <p class="text-sm text-gray-500 mt-1">Enter your registered email address to receive password reset instructions</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5"></label>
                <input asp-for="Email" class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors" placeholder="student@college.edu" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm mt-2">
                Send Reset Link
            </button>
        </form>
    </div>

    <p class="text-center text-xs text-gray-500 mt-6">
        <a asp-action="Login" class="font-semibold text-gray-900 hover:underline">&larr; Back to Sign In</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
