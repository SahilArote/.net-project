@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div style="max-width: 440px; margin: 2rem auto;">
    <div class="card">
        <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem; text-align: center;">Reset Password</h2>
        <p class="subtitle" style="text-align: center; margin-bottom: 1.5rem;">Enter your college email address to receive password reset instructions</p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="name@college.edu" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 0.5rem;">
                Send Reset Link
            </button>
        </form>
    </div>

    <div style="text-align: center; font-size: 0.875rem;">
        <a asp-action="Login">Back to Sign In</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
