@{
    ViewData["Title"] = "Password Reset Complete";
}

<div style="max-width: 480px; margin: 3rem auto; text-align: center;">
    <div class="card" style="padding: 2.5rem 1.5rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem; color: #059669;">✓</div>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Password Updated</h2>
        <p style="color: var(--text-secondary); line-height: 1.5; margin-bottom: 2rem;">
            Your password has been successfully reset. You may now log in with your new credentials.
        </p>
        <a asp-action="Login" class="btn btn-primary btn-block btn-lg">
            Sign In Now
        </a>
    </div>
</div>
