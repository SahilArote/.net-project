@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div style="max-width: 440px; margin: 1.5rem auto;">
    <div class="card">
        <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem; text-align: center;">Sign In to Portal</h2>
        <p class="subtitle" style="text-align: center; margin-bottom: 1.5rem;">Access your student complaints or administrative dashboard</p>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            @if (ViewBag.DevVerifyUrl != null)
            {
                <div style="background-color: #FEF3C7; border: 1px solid #FCD34D; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.25rem; font-size: 0.875rem;">
                    <div style="font-weight: 600; color: #92400E; margin-bottom: 0.35rem;">Email Verification Helper:</div>
                    <div style="color: #78350F; margin-bottom: 0.75rem;">If you did not receive the email, click the button below to verify your account immediately:</div>
                    <a href="@ViewBag.DevVerifyUrl" class="btn btn-primary btn-sm">
                        ✓ Verify My Email Now
                    </a>
                </div>
            }

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="name@college.edu" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                    <label asp-for="Password" class="form-label" style="margin: 0;"></label>
                    <a asp-action="ForgotPassword" style="font-size: 0.8rem;">Forgot password?</a>
                </div>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
                <input asp-for="RememberMe" id="RememberMe" type="checkbox" style="width: 16px; height: 16px;" />
                <label for="RememberMe" style="font-size: 0.875rem; color: var(--text-secondary); margin: 0; cursor: pointer;">Remember this device</label>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 0.5rem;">
                Sign In
            </button>
        </form>
    </div>

    <div style="text-align: center; font-size: 0.875rem; color: var(--text-secondary);">
        Don't have an account yet? <a asp-action="Register" style="font-weight: 500;">Register as Student</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
