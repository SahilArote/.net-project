@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="max-w-md mx-auto py-6 sm:py-12">
    <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-sm">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">Sign In to Portal</h1>
            <p class="text-sm text-gray-500 mt-1">Access your student complaints or administrative dashboard</p>
        </div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            @if (ViewBag.DevVerifyUrl != null)
            {
                <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 text-xs text-amber-900 mb-4">
                    <div class="font-semibold text-amber-800 mb-1 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Email Verification Helper:
                    </div>
                    <p class="text-amber-700 mb-2.5">If you did not receive the email, click the button below to verify your account immediately:</p>
                    <a href="@ViewBag.DevVerifyUrl" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-md transition-colors shadow-sm">
                        Verify My Email Now
                    </a>
                </div>
            }

            <div>
                <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5"></label>
                <input asp-for="Email" class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors" placeholder="student@college.edu" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-gray-600"></label>
                    <a asp-action="ForgotPassword" class="text-xs font-medium text-gray-500 hover:text-gray-900 transition-colors">Forgot password?</a>
                </div>
                <input asp-for="Password" class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input asp-for="RememberMe" id="RememberMe" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900" />
                <label for="RememberMe" class="text-xs text-gray-600 cursor-pointer select-none">Remember this device</label>
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm mt-2">
                Sign In
            </button>
        </form>
    </div>

    <p class="text-center text-xs text-gray-500 mt-6">
        Don't have an account yet?
        <a asp-action="Register" class="font-semibold text-gray-900 hover:underline">Register as Student</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
