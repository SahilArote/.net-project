@{
    ViewData["Title"] = "Registration Submitted";
}

<div style="max-width: 520px; margin: 3rem auto; text-align: center;">
    <div class="card" style="padding: 2.5rem 1.5rem;">
        <div style="font-size: 2.75rem; margin-bottom: 1rem;">✉️</div>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Check Your Email</h2>
        <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
            We have sent an activation link to <strong>@ViewBag.Email</strong>. 
            Please open the email and click the confirmation link to activate your student account.
        </p>

        <div style="background-color: var(--bg-color); border: 1px solid var(--border-color); padding: 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.75rem; text-align: left;">
            💡 <strong>Note:</strong> If you don't see the email within a couple minutes, please check your spam or junk folder.
        </div>

        @if (ViewBag.DevVerifyUrl != null)
        {
            <div style="background-color: #FEF3C7; border: 1px solid #FCD34D; border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem; text-align: left; font-size: 0.875rem;">
                <div style="font-weight: 600; color: #92400E; margin-bottom: 0.35rem;">Development Mode Helper:</div>
                <div style="color: #78350F; margin-bottom: 0.75rem;">You can activate your account directly right now by clicking below:</div>
                <a href="@ViewBag.DevVerifyUrl" class="btn btn-primary btn-sm">
                    ✓ Activate Account Immediately
                </a>
            </div>
        }

        <a asp-action="Login" class="btn btn-secondary">
            Return to Sign In
        </a>
    </div>
</div>
