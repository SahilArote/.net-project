@{
    ViewData["Title"] = "Registration Submitted";
}

<div class="max-w-md mx-auto py-8 sm:py-16 text-center">
    <div class="bg-white rounded-xl border border-gray-200 p-8 shadow-sm">
        <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>

        <h1 class="text-2xl font-bold tracking-tight text-gray-900 mb-2">Check Your Email</h1>
        <p class="text-sm text-gray-600 leading-relaxed mb-6">
            We sent an activation link to <strong class="text-gray-900 font-semibold">@ViewBag.Email</strong>. 
            Please open your inbox and click the confirmation link to activate your student account.
        </p>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-3.5 text-xs text-gray-500 mb-6 text-left flex items-start gap-2.5">
            <span class="text-base shrink-0 leading-none">💡</span>
            <div><strong>Tip:</strong> If you don't receive the email within a couple minutes, please check your spam or junk folder.</div>
        </div>

        @if (ViewBag.DevVerifyUrl != null)
        {
            <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 text-xs text-amber-900 mb-6 text-left">
                <div class="font-semibold text-amber-800 mb-1 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Development Mode Helper:
                </div>
                <p class="text-amber-700 mb-2.5">You can activate your account immediately by clicking below:</p>
                <a href="@ViewBag.DevVerifyUrl" class="inline-flex items-center px-3.5 py-2 text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-md transition-colors shadow-sm">
                    ✓ Activate Account Immediately
                </a>
            </div>
        }

        <a asp-action="Login" class="w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Return to Sign In
        </a>
    </div>
</div>
