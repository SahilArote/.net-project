@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-bottom: 0.25rem;">Welcome, @Model.StudentName</h1>
        <p class="subtitle" style="margin-bottom: 0;">College ID: <strong>@Model.CollegeId</strong></p>
    </div>
    <div>
        <a asp-controller="Complaint" asp-action="Create" class="btn btn-primary btn-lg">
            + Submit New Complaint
        </a>
    </div>
</div>

<!-- Metrics Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Complaints</div>
        <div class="stat-value">@Model.TotalComplaints</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Submitted</div>
        <div class="stat-value submitted">@Model.SubmittedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Under Review</div>
        <div class="stat-value underreview">@Model.UnderReviewCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Resolved</div>
        <div class="stat-value resolved">@Model.ResolvedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Closed</div>
        <div class="stat-value closed">@Model.ClosedCount</div>
    </div>
</div>

<!-- Recent Complaints Section -->
<div class="card">
    <div class="card-header-clean">
        <h2>Recent Complaints</h2>
        <a asp-controller="Complaint" asp-action="Index" style="font-size: 0.875rem; font-weight: 500;">
            View All Complaints &rarr;
        </a>
    </div>

    @if (!Model.RecentComplaints.Any())
    {
        <div style="text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">📋</div>
            <p style="font-size: 1.05rem; font-weight: 500; margin-bottom: 0.5rem;">No complaints submitted yet</p>
            <p style="font-size: 0.875rem; margin-bottom: 1.5rem;">Need to report an issue with classrooms, laboratories, or Wi-Fi?</p>
            <a asp-controller="Complaint" asp-action="Create" class="btn btn-primary">
                Submit Your First Complaint
            </a>
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.RecentComplaints)
                    {
                        var statusCss = c.Status.ToString().ToLower();
                        <tr>
                            <td><span class="complaint-ref">@c.ReferenceNumber</span></td>
                            <td><strong>@c.Title</strong></td>
                            <td>@c.CategoryName</td>
                            <td>@c.Location</td>
                            <td>
                                <span class="status-badge @statusCss">
                                    @c.Status
                                </span>
                            </td>
                            <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td style="text-align: right;">
                                <a asp-controller="Complaint" asp-action="Details" asp-route-id="@c.ComplaintId" class="btn btn-secondary btn-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards -->
        <div class="mobile-cards">
            @foreach (var c in Model.RecentComplaints)
            {
                var statusCss = c.Status.ToString().ToLower();
                <div class="complaint-card">
                    <div class="complaint-card-top">
                        <span class="complaint-ref">@c.ReferenceNumber</span>
                        <span class="status-badge @statusCss">@c.Status</span>
                    </div>
                    <div class="complaint-card-title">@c.Title</div>
                    <div class="complaint-card-meta">
                        <span>📁 @c.CategoryName</span>
                        <span>📍 @c.Location</span>
                        <span>🗓 @c.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                    <a asp-controller="Complaint" asp-action="Details" asp-route-id="@c.ComplaintId" class="btn btn-secondary btn-block btn-sm">
                        View Details
                    </a>
                </div>
            }
        </div>
    }
</div>
