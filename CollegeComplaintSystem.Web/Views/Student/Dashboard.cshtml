@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<!-- Welcome Section -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">Welcome, @Model.StudentName</h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1 flex items-center gap-2">
            <span>College ID:</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded font-mono font-semibold text-xs bg-gray-100 text-gray-800 border border-gray-200">
                @Model.CollegeId
            </span>
        </p>
    </div>
    <div>
        <a asp-controller="Complaint" asp-action="Create" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 shadow-sm transition-colors w-full sm:w-auto">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Submit New Complaint
        </a>
    </div>
</div>

<!-- Metrics Cards Grid -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 mb-1">Total Filed</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-gray-900">@Model.TotalComplaints</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Submitted</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-slate-700">@Model.SubmittedCount</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-amber-700 mb-1">Under Review</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-800">@Model.UnderReviewCount</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 mb-1">Resolved</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-emerald-800">@Model.ResolvedCount</div>
    </div>
    <div class="col-span-2 sm:col-span-1 bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-indigo-700 mb-1">Closed</div>
        <div class="text-2xl sm:text-3xl font-extrabold text-indigo-800">@Model.ClosedCount</div>
    </div>
</div>

<!-- Recent Complaints Section -->
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900">Recent Complaints</h2>
            <p class="text-xs text-gray-500 mt-0.5">Your most recent problem reports and resolutions</p>
        </div>
        <a asp-controller="Complaint" asp-action="Index" class="text-xs font-semibold text-gray-700 hover:text-gray-900 flex items-center gap-1 transition-colors">
            View All <span aria-hidden="true">&rarr;</span>
        </a>
    </div>

    @if (!Model.RecentComplaints.Any())
    {
        <div class="text-center py-12 px-4">
            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3 text-gray-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <p class="text-sm font-semibold text-gray-900 mb-1">No complaints submitted yet</p>
            <p class="text-xs text-gray-500 max-w-sm mx-auto mb-4">Have an issue with classrooms, laboratories, sanitation, or Wi-Fi?</p>
            <a asp-controller="Complaint" asp-action="Create" class="inline-flex items-center px-3.5 py-2 text-xs font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm">
                Submit Your First Complaint
            </a>
        </div>
    }
    else
    {
        <!-- Desktop Table View -->
        <div class="hidden md:block overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                <thead class="bg-gray-50/75">
                    <tr>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Reference</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Title</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Category</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Location</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Submitted</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var c in Model.RecentComplaints)
                    {
                        var statusLower = c.Status.ToString().ToLower();
                        var statusBadgeClasses = statusLower switch {
                            "submitted" => "bg-slate-100 text-slate-700 border-slate-200",
                            "underreview" => "bg-amber-50 text-amber-800 border-amber-200",
                            "resolved" => "bg-emerald-50 text-emerald-800 border-emerald-200",
                            "closed" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-gray-100 text-gray-700 border-gray-200"
                        };

                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="py-3 px-4 font-mono font-semibold text-xs text-gray-900 whitespace-nowrap">
                                @c.ReferenceNumber
                            </td>
                            <td class="py-3 px-4 font-medium text-gray-900 max-w-xs truncate">
                                @c.Title
                            </td>
                            <td class="py-3 px-4 text-gray-600 text-xs">
                                @c.CategoryName
                            </td>
                            <td class="py-3 px-4 text-gray-600 text-xs">
                                @c.Location
                            </td>
                            <td class="py-3 px-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border @statusBadgeClasses">
                                    @c.Status
                                </span>
                            </td>
                            <td class="py-3 px-4 text-gray-500 text-xs whitespace-nowrap">
                                @c.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-3 px-4 text-right whitespace-nowrap">
                                <a asp-controller="Complaint" asp-action="Details" asp-route-id="@c.ComplaintId" class="inline-flex items-center px-2.5 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards View -->
        <div class="md:hidden divide-y divide-gray-100 p-3 space-y-3">
            @foreach (var c in Model.RecentComplaints)
            {
                var statusLower = c.Status.ToString().ToLower();
                var statusBadgeClasses = statusLower switch {
                    "submitted" => "bg-slate-100 text-slate-700 border-slate-200",
                    "underreview" => "bg-amber-50 text-amber-800 border-amber-200",
                    "resolved" => "bg-emerald-50 text-emerald-800 border-emerald-200",
                    "closed" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                    _ => "bg-gray-100 text-gray-700 border-gray-200"
                };

                <div class="bg-gray-50/50 rounded-lg border border-gray-200 p-3.5 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="font-mono font-semibold text-xs text-gray-900">@c.ReferenceNumber</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border @statusBadgeClasses">
                            @c.Status
                        </span>
                    </div>

                    <h3 class="text-sm font-semibold text-gray-900 leading-snug">@c.Title</h3>

                    <div class="text-xs text-gray-500 space-y-1">
                        <div class="flex items-center gap-1.5">
                            <span class="text-gray-400">Category:</span>
                            <span class="font-medium text-gray-700">@c.CategoryName</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-gray-400">Location:</span>
                            <span class="text-gray-700">@c.Location</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="text-gray-400">Filed:</span>
                            <span class="text-gray-700">@c.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-gray-200/80">
                        <a asp-controller="Complaint" asp-action="Details" asp-route-id="@c.ComplaintId" class="w-full inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors">
                            View Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
