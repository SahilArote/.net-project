@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="bg-white rounded-xl border border-gray-200 p-8 shadow-sm">
        <h1 class="text-2xl font-bold text-gray-900 mb-4">Privacy Policy</h1>
        <div class="prose prose-sm text-gray-600 space-y-4">
            <p>
                The College Complaint Management System is dedicated to protecting student and staff privacy. Information collected during complaint filing is strictly utilized for problem diagnosis, facility maintenance, and administrative resolution.
            </p>
            <h2 class="text-base font-semibold text-gray-900 pt-2">Data Protection & Privacy Principles</h2>
            <ul class="list-disc list-inside space-y-1.5 text-sm">
                <li>Uploaded photographs are stored securely via encrypted cloud storage and accessible only by authorized campus personnel.</li>
                <li>Student contact information and College ID are restricted to relevant administrators.</li>
                <li>Audit history logs preserve chronological records of all status updates and administrative remarks.</li>
            </ul>
        </div>
    </div>
</div>
