@model ComplaintDetailsViewModel
@{
    ViewData["Title"] = $"Complaint {Model.ReferenceNumber}";
    var statusCss = Model.Status.ToString().ToLower();
}

<div style="max-width: 800px; margin: 1.5rem auto;">
    <!-- Top Action Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            &larr; Back to My Complaints
        </a>
        <div style="display: flex; gap: 0.5rem;">
            @if (Model.CanEditOrDelete)
            {
                <a asp-action="Edit" asp-route-id="@Model.ComplaintId" class="btn btn-secondary btn-sm">
                    ✏️ Edit
                </a>
                <form asp-action="Delete" asp-route-id="@Model.ComplaintId" method="post" onsubmit="return confirm('Are you sure you want to delete this complaint? This action cannot be undone.');" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        🗑️ Delete
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Main Complaint Card -->
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <div>
                <span class="complaint-ref" style="font-size: 1rem;">@Model.ReferenceNumber</span>
                <h1 style="font-size: 1.5rem; margin: 0.25rem 0 0 0;">@Model.Title</h1>
            </div>
            <div>
                <span class="status-badge @statusCss" style="font-size: 0.9rem; padding: 0.35rem 0.85rem;">
                    @Model.Status
                </span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; background-color: var(--bg-color); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <div>
                <span class="form-label" style="font-size: 0.775rem; color: var(--text-muted); text-transform: uppercase;">Category</span>
                <div style="font-weight: 600;">@Model.CategoryName</div>
            </div>
            <div>
                <span class="form-label" style="font-size: 0.775rem; color: var(--text-muted); text-transform: uppercase;">Location</span>
                <div style="font-weight: 600;">@Model.Location</div>
            </div>
            <div>
                <span class="form-label" style="font-size: 0.775rem; color: var(--text-muted); text-transform: uppercase;">Submitted Date</span>
                <div style="color: var(--text-secondary);">@Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")</div>
            </div>
        </div>

        <!-- Description -->
        <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 0.75rem;">Description</h3>
            <div style="line-height: 1.6; white-space: pre-wrap; color: var(--text-primary);">@Model.Description</div>
        </div>

        <!-- Attached Image if present -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div style="margin-bottom: 2rem;">
                <h3 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 0.75rem;">Attached Supporting Image</h3>
                <div style="border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; max-width: 500px;">
                    <a href="@Model.ImageUrl" target="_blank" title="Click to view full size">
                        <img src="@Model.ImageUrl" alt="Complaint evidence photo" style="width: 100%; max-height: 400px; object-fit: contain; background: #000000; display: block;" />
                    </a>
                </div>
                <div class="form-text">Click the image to view the full resolution photo.</div>
            </div>
        }

        <!-- Permissions Note for Review Phase -->
        @if (!Model.CanEditOrDelete)
        {
            <div style="background-color: var(--primary-light); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.85rem 1rem; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
                ℹ️ <strong>Review in progress:</strong> This complaint is currently <strong>@Model.Status</strong>. Editing and deletion are disabled once administrative review commences.
            </div>
        }

        <!-- Status History Timeline -->
        <div>
            <h3 style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-secondary); margin-bottom: 1rem;">Status Timeline</h3>
            <div class="timeline">
                @foreach (var h in Model.StatusHistories)
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-time">@h.ChangedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                        <div class="timeline-content">
                            <strong>@h.NewStatus</strong>
                            @if (!string.IsNullOrEmpty(h.Notes))
                            {
                                <span style="color: var(--text-secondary);"> — @h.Notes</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
