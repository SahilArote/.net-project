@model ComplaintCreateViewModel
@{
    ViewData["Title"] = "Submit Complaint";
}

<div style="max-width: 700px; margin: 1.5rem auto;">
    <div class="card">
        <div class="card-header-clean">
            <div>
                <h2>Submit a Complaint</h2>
                <p class="subtitle" style="margin-bottom: 0;">Fill in the details below. Our administrative team will review your report.</p>
            </div>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Brief summary of the issue (e.g. Wi-Fi down in Lab 3)" autofocus />
                <span asp-validation-for="Title"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId"></span>
            </div>

            <div class="form-group">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="e.g. Main Building, Room 204" />
                <div class="form-text">Specify the building, wing, room number, or area where the problem occurred.</div>
                <span asp-validation-for="Location"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide full details regarding the problem..."></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageFile" class="form-label">Supporting Photo (Optional)</label>
                
                <!-- Hidden inputs -->
                <input asp-for="ImageFile" type="file" id="image-upload-input" class="form-control" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />
                <input type="file" id="camera-direct-input" accept="image/*" capture="environment" style="display:none;" />

                <div class="image-picker-wrapper">
                    <div style="font-size: 0.95rem; font-weight: 500; margin-bottom: 0.65rem;">Add Photo Evidence</div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 1rem;">
                        Upload a saved picture or take a live photo using your camera.
                    </div>

                    <div class="image-picker-buttons">
                        <button type="button" id="btn-choose-file" class="btn btn-secondary">
                            📁 Choose from Gallery / Files
                        </button>
                        <button type="button" id="btn-open-camera" class="btn btn-primary">
                            📸 Take Photo with Camera
                        </button>
                    </div>

                    <!-- Live Camera Viewfinder Box -->
                    <div id="camera-viewfinder-box" class="camera-viewfinder-box">
                        <video id="camera-stream" autoplay playsinline muted></video>
                        <div class="camera-controls-bar">
                            <button type="button" id="btn-capture-photo" class="btn btn-success btn-sm">
                                📸 Snap Photo
                            </button>
                            <button type="button" id="btn-cancel-camera" class="btn btn-secondary btn-sm">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <!-- Selected/Snapped Image Preview Card -->
                    <div id="image-preview-container" class="preview-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <span id="image-preview-info" style="font-size: 0.825rem; font-weight: 600; color: var(--text-primary);"></span>
                            <button type="button" id="btn-remove-photo" class="btn btn-danger btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.775rem;">
                                ✕ Remove / Retake
                            </button>
                        </div>
                        <img id="image-preview" src="#" alt="Selected Image Preview" />
                    </div>
                </div>

                <div class="form-text" style="margin-top: 0.5rem;">Supported formats: JPG, PNG, WEBP (Max 5MB).</div>
                <span asp-validation-for="ImageFile"></span>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary btn-lg">
                    Submit Complaint
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
