@model ComplaintListViewModel
@{
    ViewData["Title"] = "My Complaints";
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">My Complaints</h1>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Track and manage complaints you have filed</p>
    </div>
    <div>
        <a asp-action="Create" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 shadow-sm transition-colors w-full sm:w-auto">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Submit Complaint
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-sm mb-6">
    <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 items-end">
        <div class="sm:col-span-6 lg:col-span-7">
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5" for="search">Search</label>
            <input type="text" id="search" name="search" value="@Model.Search" class="w-full rounded-lg border border-gray-300 px-3.5 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors" placeholder="Search reference, title, location..." />
        </div>

        <div class="sm:col-span-3 lg:col-span-3">
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5" for="status">Status</label>
            <select id="status" name="status" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 bg-white focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors">
                <option value="">All Statuses</option>
                @foreach (var val in Enum.GetValues<ComplaintStatus>())
                {
                    <option value="@val" selected="@(Model.Status == val)">@val</option>
                }
            </select>
        </div>

        <div class="sm:col-span-3 lg:col-span-2 flex items-center gap-2">
            <button type="submit" class="flex-1 inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm">
                Filter
            </button>
            <a asp-action="Index" class="inline-flex items-center justify-center px-3.5 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                Reset
            </a>
        </div>
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center shadow-sm">
        <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3 text-gray-400">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
        <p class="text-base font-semibold text-gray-900 mb-1">No matching complaints found</p>
        <p class="text-xs text-gray-500 max-w-sm mx-auto mb-4">Try modifying your search or filter criteria, or submit a new complaint.</p>
        <a asp-action="Create" class="inline-flex items-center px-3.5 py-2 text-xs font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm">
            Submit New Complaint
        </a>
    </div>
}
else
{
    <!-- Desktop Table View -->
    <div class="hidden md:block bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                <thead class="bg-gray-50/75">
                    <tr>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Reference</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Title</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Category</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Location</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider">Submitted</th>
                        <th scope="col" class="py-3 px-4 text-xs font-semibold text-gray-600 uppercase tracking-wider text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    @foreach (var item in Model.Items)
                    {
                        var statusLower = item.Status.ToString().ToLower();
                        var statusBadgeClasses = statusLower switch {
                            "submitted" => "bg-slate-100 text-slate-700 border-slate-200",
                            "underreview" => "bg-amber-50 text-amber-800 border-amber-200",
                            "resolved" => "bg-emerald-50 text-emerald-800 border-emerald-200",
                            "closed" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                            _ => "bg-gray-100 text-gray-700 border-gray-200"
                        };

                        <tr class="hover:bg-gray-50/60 transition-colors">
                            <td class="py-3 px-4 whitespace-nowrap">
                                <span class="font-mono font-semibold text-xs text-gray-900">@item.ReferenceNumber</span>
                                @if (item.HasImage)
                                {
                                    <span class="inline-block text-xs text-gray-400 ml-1.5" title="Has photo attachment">📷</span>
                                }
                            </td>
                            <td class="py-3 px-4 font-medium text-gray-900 max-w-xs truncate">
                                @item.Title
                            </td>
                            <td class="py-3 px-4 text-gray-600 text-xs">
                                @item.CategoryName
                            </td>
                            <td class="py-3 px-4 text-gray-600 text-xs">
                                @item.Location
                            </td>
                            <td class="py-3 px-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border @statusBadgeClasses">
                                    @item.Status
                                </span>
                            </td>
                            <td class="py-3 px-4 text-gray-500 text-xs whitespace-nowrap">
                                @item.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-3 px-4 text-right whitespace-nowrap">
                                <a asp-action="Details" asp-route-id="@item.ComplaintId" class="inline-flex items-center px-2.5 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 transition-colors">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Cards View -->
    <div class="md:hidden space-y-3">
        @foreach (var item in Model.Items)
        {
            var statusLower = item.Status.ToString().ToLower();
            var statusBadgeClasses = statusLower switch {
                "submitted" => "bg-slate-100 text-slate-700 border-slate-200",
                "underreview" => "bg-amber-50 text-amber-800 border-amber-200",
                "resolved" => "bg-emerald-50 text-emerald-800 border-emerald-200",
                "closed" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                _ => "bg-gray-100 text-gray-700 border-gray-200"
            };

            <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <span class="font-mono font-semibold text-xs text-gray-900">@item.ReferenceNumber</span>
                        @if (item.HasImage)
                        {
                            <span class="text-xs text-gray-400" title="Has photo attachment">📷</span>
                        }
                    </div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border @statusBadgeClasses">
                        @item.Status
                    </span>
                </div>

                <h3 class="text-sm font-semibold text-gray-900 leading-snug">@item.Title</h3>

                <div class="text-xs text-gray-500 space-y-1">
                    <div class="flex items-center gap-1.5">
                        <span class="text-gray-400">Category:</span>
                        <span class="font-medium text-gray-700">@item.CategoryName</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-gray-400">Location:</span>
                        <span class="text-gray-700">@item.Location</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-gray-400">Submitted:</span>
                        <span class="text-gray-700">@item.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <div class="pt-2 border-t border-gray-100">
                    <a asp-action="Details" asp-route-id="@item.ComplaintId" class="w-full inline-flex items-center justify-center px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        View Details
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-6 border-t border-gray-200 mt-6 text-xs text-gray-600">
            <div>
                Showing page <strong class="font-semibold text-gray-900">@Model.PageNumber</strong> of <strong class="font-semibold text-gray-900">@Model.TotalPages</strong> (@Model.TotalCount total complaints)
            </div>
            <div class="flex items-center gap-2">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="inline-flex items-center px-3 py-1.5 font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        &larr; Previous
                    </a>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="inline-flex items-center px-3 py-1.5 font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        Next &rarr;
                    </a>
                }
            </div>
        </div>
    }
}
