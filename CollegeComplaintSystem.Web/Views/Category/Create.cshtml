@model CategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div style="max-width: 550px; margin: 1.5rem auto;">
    <div class="card">
        <div class="card-header-clean">
            <h2>Add Complaint Category</h2>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Cafeteria & Food Services" autofocus />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief explanation of the types of issues in this category..."></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
                <input asp-for="IsActive" type="checkbox" id="IsActive" style="width: 16px; height: 16px;" />
                <label for="IsActive" style="font-size: 0.875rem; color: var(--text-primary); margin: 0; cursor: pointer;">Available for new student complaints</label>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Category</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
