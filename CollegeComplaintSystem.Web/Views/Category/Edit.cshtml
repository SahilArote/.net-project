@model CategoryViewModel
@{
    ViewData["Title"] = $"Edit Category {Model.Name}";
}

<div class="max-w-lg mx-auto py-6 sm:py-10">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-8">
        <div class="border-b border-gray-200 pb-5 mb-6">
            <h1 class="text-2xl font-bold tracking-tight text-gray-900">Edit Category</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Update category information and availability status</p>
        </div>

        <form asp-action="Edit" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input asp-for="CategoryId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div>
                <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5"></label>
                <input asp-for="Name" class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors" autofocus />
                <span asp-validation-for="Name"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-gray-600 mb-1.5"></label>
                <textarea asp-for="Description" rows="3" class="w-full rounded-lg border border-gray-300 px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900 transition-colors resize-y"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input asp-for="IsActive" type="checkbox" id="IsActive" class="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900" />
                <label for="IsActive" class="text-xs text-gray-700 cursor-pointer select-none">Active (Accepting new student complaints)</label>
            </div>

            <div class="pt-5 border-t border-gray-200 flex items-center justify-end gap-3">
                <a asp-action="Index" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center px-5 py-2 text-sm font-semibold text-white bg-gray-900 rounded-lg hover:bg-gray-800 transition-colors shadow-sm">
                    Update Category
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
